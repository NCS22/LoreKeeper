# Copy this file to `.env` and replace every placeholder with your own value.
# `.env` is git-ignored: never commit it and never paste its values into the repository.

# PostgreSQL container (docker-compose.yml).
POSTGRES_USER=lorekeeper
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_DB=lorekeeper
# Host port of the container; change it only if 5432 is already in use, and change the two URLs below to match.
POSTGRES_PORT=5432

# Connection strings. Use the same user, password and port as above.
# If the password contains special characters, percent-encode them in the URL.
DATABASE_URL=postgresql://lorekeeper:replace-with-your-database-password@localhost:5432/lorekeeper
# A separate database for the tests; the test setup creates it if it does not exist. It must be on this machine, differ from DATABASE_URL, and its name must end with "_test" or start with "lorekeeper_test".
TEST_DATABASE_URL=postgresql://lorekeeper:replace-with-your-database-password@localhost:5432/lorekeeper_test

# Better Auth: a long random string (at least 32 characters) and the public address of the application.
# Generate the random string with a command such as `openssl rand -base64 48`. The application rejects a
# secret or a database password that still begins with "replace-with".
BETTER_AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
